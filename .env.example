# BFF консоли (apps/bff/src/config.ts). Секреты — файлами, здесь только пути к ним.
CONSOLE_PUBLIC_URL=https://cp.example.com
CONSOLE_BASE_PATH=/console
CONSOLE_COOKIE_SECRET_FILE=/run/secrets/console_cookie_secret
CONSOLE_OIDC_ISSUER=https://cp.example.com/auth/realms/platform
CONSOLE_OIDC_CLIENT_ID=runtime-console
CONSOLE_OIDC_SECRET_FILE=/run/secrets/console_oidc_secret
CONSOLE_IAM_URL=http://iam-service:8010
CONSOLE_IAM_TENANT=
CONSOLE_CONTROL_PLANE_URL=http://control-plane-api:8000
CONSOLE_LAUNCHER_URL=http://harness-launcher:8080/harness
CONSOLE_CP_SCOPES=control-plane:read control-plane:write
CONSOLE_SESSION_TTL_HOURS=12
# Бренд — при запуске, а не в сборке.
CONSOLE_PRODUCT_NAME=Console
CONSOLE_ORG_NAME=
# Языки интерфейса: английский — основной язык поставки.
CONSOLE_LOCALES=en,ru
CONSOLE_DEFAULT_LOCALE=en
